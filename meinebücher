  line-height: 1.8;
}

.intro p:last-child {
  margin-bottom: 0;
}

/* Buchkarten */

.book {
  display: inline-flex;
  flex-direction: column;
  vertical-align: top;
  width: 250px;
  max-width: calc(100% - 24px);
  margin: 12px;
  padding: 16px;
  background: linear-gradient(160deg, #fffafd, #f8f0fa);
  border: 1px solid #e8d8eb;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(105, 76, 117, .09);
  text-align: center;
  position: relative;
  z-index: 1;
  transition: transform .25s ease, box-shadow .25s ease;
}

.book:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 28px rgba(105, 76, 117, .16);
}

.book img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 360px;
  object-fit: contain;
  border-radius: 10px;
  background: #fff;
}

.book p {
  margin: 14px 0 0;
  font-size: 1em;
  line-height: 1.55;
  color: #59485e;
}

.book p:first-of-type {
  font-weight: 700;
}

/* Bücher ohne fertiges Cover */

.book:not(:has(img)) {
  min-height: 180px;
  justify-content: center;
  background: linear-gradient(145deg, #f7eaf4, #eee6fa);
  border: 1px dashed #cbb3d6;
}

.book:not(:has(img)) p:first-child {
  color: #8c6b9f;
  font-size: 1.2em;
}

/* Urheberrecht und Abschluss */

body > p {
  max-width: 900px;
  margin: 12px auto;
  padding: 0 20px;
  font-size: .95em;
  line-height: 1.65;
  position: relative;
