*, *::before, *::after {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: #fffdf8;
  color-scheme: light;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
