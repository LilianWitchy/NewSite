    radial-gradient(ellipse at 92% 18%, rgba(220, 207, 246, .35), transparent 35%),
    radial-gradient(ellipse at 12% 75%, rgba(248, 226, 210, .24), transparent 32%),
    #fffdf8;
  overflow-x: hidden;
  position: relative;
}

img {
  max-width: 100%;
  height: auto;
}

/* Sanfter Sternenhimmel */

.stars {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  opacity: .65;
  background-image:
    radial-gradient(2px 2px at 8% 15%, #d9b86a 98%, transparent),
    radial-gradient(2px 2px at 22% 38%, #d7a9c6 98%, transparent),
    radial-gradient(2px 2px at 40% 12%, #c6b0e8 98%, transparent),
    radial-gradient(2px 2px at 58% 28%, #d9b86a 98%, transparent),
    radial-gradient(2px 2px at 74% 18%, #d7a9c6 98%, transparent),
    radial-gradient(2px 2px at 91% 42%, #c6b0e8 98%, transparent),
    radial-gradient(2px 2px at 15% 66%, #c6b0e8 98%, transparent),
    radial-gradient(2px 2px at 48% 78%, #d9b86a 98%, transparent),
    radial-gradient(2px 2px at 83% 72%, #d7a9c6 98%, transparent),
    radial-gradient(1px 1px at 30% 85%, #d9b86a 98%, transparent),
    radial-gradient(1px 1px at 67% 57%, #c6b0e8 98%, transparent);
  animation: starGlow 5s ease-in-out infinite alternate;
}

@keyframes starGlow {
  from { opacity: .35; }
  to { opacity: .8; }
}

@media (prefers-reduced-motion: reduce) {
  .stars {
    animation: none;
  }
}

/* Hauptüberschrift */

.content {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px 20px 8px;
  text-align: center;
  position: relative;
  z-index: 1;
}

h1 {
  font-size: clamp(2.5rem, 6vw, 4rem);
  line-height: 1.2;
  margin: 20px 0;
  color: #8c6b9f;
  font-weight: 700;
  text-shadow: 0 2px 18px rgba(207, 176, 225, .25);
}

h1::before {
  content: "✧";
  display: block;
  margin-bottom: 4px;
  color: #c7a65b;
  font-size: .55em;
}

h2 {
  font-size: clamp(1.8rem, 4vw, 2.5rem);
  line-height: 1.3;
  margin: 0 0 24px;
  color: #916f9e;
  font-weight: 700;
}

p {
  font-size: 1.08em;
  color: #554754;
}

/* Sprachauswahl */

#language-switcher {
  position: relative;
  z-index: 11;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  padding: 8px 12px 18px;
}

#language-switcher a {
  display: inline-flex;
  padding: 5px;
  border-radius: 50%;
  transition: transform .2s ease, background .2s ease;
}

#language-switcher a:hover {
  transform: translateY(-2px);
  background: #f3e8f6;
}

#language-switcher img {
  display: block;
  width: 26px;
  height: auto;
}

/* Navigation */

.navbar {
  background: rgba(246, 237, 249, .96);
  border-top: 1px solid #eadced;
  border-bottom: 1px solid #eadced;
  padding: 8px 18px;
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: center;
  align-items: center;
}

.menu-toggle {
  display: none;
  background: transparent;
  border: 1px solid #d8c5df;
  border-radius: 8px;
  padding: 6px 10px;
  cursor: pointer;
  flex-direction: column;
}

.menu-toggle span {
  height: 3px;
  width: 25px;
  background: #795e87;
  margin: 4px 0;
  border-radius: 2px;
}

.navmenu {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 2px;
}

.navmenu li {
  position: relative;
  margin: 0;
}

.navmenu a {
  text-decoration: none;
  color: #594b60;
  font-size: 17px;
  padding: 9px 11px;
  display: block;
  border-radius: 8px;
  transition: background .2s ease, color .2s ease;
}

.navmenu a:hover,
.navmenu a:focus-visible {
  background: #eadcf0;
  color: #79518c;
  outline: none;
}

/* Dropdown-Menüs */

.dropdown-content {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background: #fffafd;
  min-width: 230px;
  box-shadow: 0 8px 24px rgba(91, 65, 100, .13);
  border: 1px solid #eadced;
  border-radius: 10px;
  z-index: 1000;
  list-style: none;
  padding: 7px;
  text-align: left;
}

.dropdown-content li a {
  color: #594b60;
  padding: 9px 12px;
  font-size: 17px;
}

.dropdown-content li a:hover {
  background: #f5e7f1;
  color: #79518c;
}

.navmenu li:hover > .dropdown-content,
.navmenu li:focus-within > .dropdown-content,
.navmenu li.open > .dropdown-content {
  display: block;
}

/* Einleitung */

.intro {
  max-width: 1050px;
  width: calc(100% - 36px);
  margin: 38px auto 34px;
  padding: clamp(24px, 5vw, 48px);
  background: linear-gradient(135deg, #fff7fa, #f5effb 65%, #fffaf2);
